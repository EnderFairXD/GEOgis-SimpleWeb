# Producción con docker-compose.prod.yml. Copia este archivo a .env.prod y rellénalo
# (.env.prod no se sube al repositorio ni entra en la imagen).

# Clave larga y aleatoria. Genera una con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Dominio (o dominios, separados por comas) desde el que se sirve la web
DJANGO_ALLOWED_HOSTS=geogis.example.com
# Lo mismo, con esquema: hace falta para el login del admin y para mover estaciones
DJANGO_CSRF_TRUSTED_ORIGINS=https://geogis.example.com

# Contraseña de la base de datos (la crea PostGIS la primera vez)
DB_PASSWORD=

# Opcional
# DB_NAME=GeoDjango
# DB_USER=geogis
# PUERTO=8000                       # puerto local en el que escucha, para el proxy
# WEB_CONCURRENCY=3                 # procesos de gunicorn
# DJANGO_SECURE_HSTS_SECONDS=31536000
